{
  "name": "webapptemplate",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "pnpm --recursive --if-present lint",
    "format": "pnpm --recursive --if-present format",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "db:generate": "pnpm --filter @repo/web db:generate",
    "db:migrate": "pnpm --filter @repo/web db:migrate",
    "db:studio": "pnpm --filter @repo/web db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4"
  }
}
