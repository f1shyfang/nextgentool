{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "start": "next start",
    "verify:app": "node scripts/verify-app.mjs",
    "pipeline:member": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/provision-pipeline-member.ts",
    "research:admin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/research-admin.ts",
    "test:company:e2e": "playwright test --config playwright.company.config.ts"
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.10",
    "drizzle-orm": "^0.44.7",
    "next": "16.4.3",
    "postgres": "^3.4.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.1.12",
    "@clerk/nextjs": "7.9.20",
    "html-react-parser": "5.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4",
    "cheerio": "1.1.2",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2",
    "@playwright/test": "^1.64.1"
  }
}
