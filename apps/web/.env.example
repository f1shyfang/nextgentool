DATABASE_URL=postgres://postgres:postgres@localhost:5432/webapptemplate

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional local-only Company Intelligence integration test database.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/company_intelligence_test

# Research storage must be outside public/ and backed by persistent private disk.
RESEARCH_STORAGE_PATH=.research-private
# Private ClamAV INSTREAM endpoint. Scanning failures keep files inaccessible.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
